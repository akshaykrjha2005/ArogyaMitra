// Prisma Schema for PHC Connect (ArogyaMitra)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  PHARMACIST
  ADMIN
  RECEPTIONIST
}

enum ComplaintCategory {
  SERVICE_QUALITY
  STAFF_BEHAVIOUR
  MEDICINE_AVAILABILITY
  FACILITY_CLEANLINESS
  WAIT_TIME
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DoctorStatus {
  AVAILABLE
  BUSY
  OFFLINE
  ON_LEAVE
}

enum AppointmentStatus {
  Pending
  Confirmed
  Checked_In
  In_Consultation
  Completed
  Cancelled
}

enum TriageRiskLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum ReferralType {
  Patient_Treated
  Follow_up_Required
  Referred_to_Specialist
  Emergency_Referral
}

model User {
  id           String      @id @default(uuid())
  email        String?     @unique
  phone        String?     @unique
  passwordHash String
  role         UserRole
  fullName     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  patient      Patient?
  doctor       Doctor?
  pharmacist   Pharmacist?
  admin        Admin?
  auditLogs    AuditLog[]
  notifications Notification[]
  complaints   Complaint[]

  @@map("users")
}

model PHC {
  id                String       @id @default(uuid())
  code              String       @unique
  name              String
  type              String       // Urban PHC, Rural PHC, CHC
  address           String
  district          String
  state             String
  pincode           String
  latitude          Float
  longitude         Float
  phone             String
  email             String
  openingHours      String
  emergencyServices Boolean      @default(false)
  totalBeds         Int          @default(6)
  departments       String       // JSON encoded list of departments
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  doctors           Doctor[]
  pharmacists       Pharmacist[]
  admins            Admin[]
  appointments      Appointment[]
  inventory         MedicineInventory[]
  medicalRecords    MedicalRecord[]
  transactions      MedicineTransaction[]
  complaints        Complaint[]

  @@map("phcs")
}

model Patient {
  id                      String              @id @default(uuid())
  userId                  String              @unique
  patientId               String              @unique // e.g. PHC-PAT-2026-0001
  fullName                String
  age                     Int
  gender                  String
  phone                   String
  email                   String?
  address                 String
  latitude                Float?
  longitude               Float?
  emergencyContactName    String
  emergencyContactPhone   String
  emergencyContactRelation String
  bloodGroup              String?
  allergies               String              // JSON array
  existingConditions      String              // JSON array
  currentMedications      String              // JSON array
  medicalHistoryNotes     String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments            Appointment[]
  medicalRecords          MedicalRecord[]
  symptomAssessments      SymptomAssessment[]
  documents               PatientDocument[]

  @@map("patients")
}

model Doctor {
  id                String             @id @default(uuid())
  userId            String             @unique
  doctorId          String             @unique // e.g. PHC-DOC-101
  fullName          String
  email             String             @unique
  phone             String
  qualification     String
  specialization    String
  yearsOfExperience Int
  phcId             String
  workingHours      String
  status            DoctorStatus       @default(AVAILABLE)
  roomNumber        String?
  avatarUrl         String?
  rating            Float              @default(4.8)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phc               PHC                @relation(fields: [phcId], references: [id])
  appointments      Appointment[]
  medicalRecords    MedicalRecord[]
  availabilities    DoctorAvailability[]

  @@map("doctors")
}

model DoctorAvailability {
  id         String       @id @default(uuid())
  doctorId   String
  dayOfWeek  Int          // 0-6 (Sunday to Saturday)
  startTime  String       // "09:00 AM"
  endTime    String       // "04:00 PM"
  isAvailable Boolean     @default(true)

  doctor     Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_availability")
}

model Pharmacist {
  id            String    @id @default(uuid())
  userId        String    @unique
  pharmacistId  String    @unique
  fullName      String
  email         String    @unique
  phone         String
  phcId         String
  licenseNumber String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phc           PHC       @relation(fields: [phcId], references: [id])

  @@map("pharmacists")
}

model Admin {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  email       String    @unique
  phone       String
  phcId       String
  designation String    @default("Medical Officer In-Charge")
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phc         PHC       @relation(fields: [phcId], references: [id])

  @@map("admins")
}

model Appointment {
  id                   String            @id @default(uuid())
  appointmentNumber    String            @unique // e.g. APT-2026-001
  patientId            String
  doctorId             String
  phcId                String
  date                 String            // YYYY-MM-DD
  timeSlot             String            // e.g. "10:00 AM"
  tokenNumber          Int
  reasonForVisit       String
  symptoms             String            // JSON array
  criticalityLevel     TriageRiskLevel   @default(LOW)
  status               AppointmentStatus @default(Confirmed)
  assessmentId         String?
  consultationNotes    String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  patient              Patient           @relation(fields: [patientId], references: [id])
  doctor               Doctor            @relation(fields: [doctorId], references: [id])
  phc                  PHC               @relation(fields: [phcId], references: [id])
  medicalRecord        MedicalRecord?

  @@index([patientId])
  @@index([doctorId])
  @@index([phcId])
  @@index([date])
  @@map("appointments")
}

model SymptomAssessment {
  id                 String          @id @default(uuid())
  patientId          String?
  symptoms           String          // JSON array
  duration           String
  severity           String
  age                Int
  existingConditions String          // JSON array
  allergies          String          // JSON array
  currentMedications String          // JSON array
  riskLevel          TriageRiskLevel
  possibleConditions String          // JSON array of objects
  recommendedAction  String
  explanation        String
  requiresDoctor     Boolean         @default(true)
  emergencyWarning   Boolean         @default(false)
  uploadedPhotoUrl   String?
  photoAnalysisNotes String?
  disclaimer         String
  createdAt          DateTime        @default(now())

  patient            Patient?        @relation(fields: [patientId], references: [id])

  @@map("symptom_assessments")
}

model MedicalRecord {
  id                 String        @id @default(uuid())
  recordNumber       String        @unique // e.g. REC-2026-0001
  patientId          String
  doctorId           String
  phcId              String
  appointmentId      String?       @unique
  visitDate          String
  chiefComplaints    String        // JSON array
  clinicalAssessment String
  diagnosis          String        // JSON array
  vitals             String?       // JSON object (bp, pulse, temp, spo2, weight)
  recommendedTests   String?       // JSON array
  followUpDate       String?
  referralType       ReferralType  @default(Patient_Treated)
  referralDetails    String?
  doctorNotes        String
  createdAt          DateTime      @default(now())

  patient            Patient       @relation(fields: [patientId], references: [id])
  doctor             Doctor        @relation(fields: [doctorId], references: [id])
  phc                PHC           @relation(fields: [phcId], references: [id])
  appointment        Appointment?  @relation(fields: [appointmentId], references: [id])
  prescriptions      PrescriptionItem[]

  @@map("medical_records")
}

model PrescriptionItem {
  id              String         @id @default(uuid())
  medicalRecordId String
  medicineId      String?
  medicineName    String
  genericName     String?
  dosage          String
  frequency       String
  duration        String
  instructions    String

  medicalRecord   MedicalRecord  @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  medicine        Medicine?      @relation(fields: [medicineId], references: [id])

  @@map("prescription_items")
}

model Medicine {
  id               String                 @id @default(uuid())
  name             String
  genericName      String
  category         String
  strength         String
  form             String                 // Tablet, Syrup, etc.
  description      String?
  manufacturer     String
  storageCondition String?
  isEssential      Boolean                @default(true)
  createdAt        DateTime               @default(now())

  inventory        MedicineInventory[]
  prescriptions    PrescriptionItem[]
  transactions     MedicineTransaction[]

  @@map("medicines")
}

model MedicineInventory {
  id                String       @id @default(uuid())
  medicineId        String
  phcId             String
  quantity          Int
  minimumStockLevel Int          @default(50)
  batchNumber       String
  expiryDate        String       // YYYY-MM-DD
  supplier          String
  costPerUnit       Float        @default(0.0)
  updatedAt         DateTime     @updatedAt

  medicine          Medicine     @relation(fields: [medicineId], references: [id])
  phc               PHC          @relation(fields: [phcId], references: [id])

  @@unique([medicineId, phcId, batchNumber])
  @@map("medicine_inventory")
}

model MedicineTransaction {
  id             String    @id @default(uuid())
  medicineId     String
  medicineName   String
  phcId          String
  type           String    // DISPENSED, RESTOCKED, EXPIRED_DISPOSAL
  quantity       Int
  patientId      String?
  patientName    String?
  prescriptionId String?
  dispensedBy    String
  batchNumber    String
  notes          String?
  timestamp      DateTime  @default(now())

  medicine       Medicine  @relation(fields: [medicineId], references: [id])
  phc            PHC       @relation(fields: [phcId], references: [id])

  @@map("medicine_transactions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  patientId String?
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PatientDocument {
  id        String   @id @default(uuid())
  patientId String
  title     String
  fileUrl   String
  fileType  String
  uploadedAt DateTime @default(now())

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_documents")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Complaint {
  id              String             @id @default(uuid())
  complaintId     String             @unique // e.g. CMP-2026-0001
  userId          String
  userName        String
  userPhone       String?
  userEmail       String?
  userRole        UserRole           @default(PATIENT)
  phcId           String
  phcName         String
  category        ComplaintCategory
  subject         String
  description     String
  attachmentUrl   String?
  attachmentName  String?
  priority        ComplaintPriority  @default(MEDIUM)
  status          ComplaintStatus    @default(OPEN)
  assignedToId    String?
  assignedToName  String?
  assignedToRole  UserRole?
  resolutionNotes String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phc             PHC                @relation(fields: [phcId], references: [id])
  history         ComplaintHistory[]
  replies         ComplaintReply[]

  @@map("complaints")
}

model ComplaintHistory {
  id          String           @id @default(uuid())
  complaintId String
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus
  actorId     String
  actorName   String
  actorRole   UserRole
  note        String
  timestamp   DateTime         @default(now())

  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_history")
}

model ComplaintReply {
  id          String    @id @default(uuid())
  complaintId String
  authorId    String
  authorName  String
  authorRole  UserRole
  message     String
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_replies")
}

enum CallbackStatus {
  Pending
  Called
  Missed
  Completed
  Cancelled
}

enum CallOutcome {
  CONNECTED
  BUSY
  NO_ANSWER
  FAILED
  CALLBACK_RESOLVED
}

model CallbackRequest {
  id                String         @id @default(uuid())
  requestId         String         @unique // e.g. CB-2026-0001
  patientId         String?
  name              String
  phone             String
  reason            String
  preferredTime     String
  phcId             String?
  status            CallbackStatus @default(Pending)
  assignedStaffId   String?
  assignedStaffName String?
  notes             String?
  callAttempts      Int            @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  patient           Patient?       @relation(fields: [patientId], references: [id])
  phc               PHC?           @relation(fields: [phcId], references: [id])
  callLogs          CallLog[]

  @@map("callback_requests")
}

model CallLog {
  id                String       @id @default(uuid())
  callSessionId     String?
  callerName        String
  callerPhone       String
  receiverName      String
  receiverPhone     String
  receiverRole      String
  direction         String       // INBOUND or OUTBOUND
  purpose           String
  outcome           CallOutcome  @default(CONNECTED)
  durationSeconds   Int          @default(0)
  notes             String?
  callbackRequestId String?
  phcId             String?
  timestamp         DateTime     @default(now())

  callbackRequest   CallbackRequest? @relation(fields: [callbackRequestId], references: [id])
  phc               PHC?             @relation(fields: [phcId], references: [id])

  @@map("call_logs")
}

enum FollowUpStatus {
  PENDING
  OVERDUE
  COMPLETED
  MISSED
  CANCELLED
}

enum PatientConditionState {
  IMPROVED
  STABLE
  DETERIORATING
  CRITICAL
  RECOVERED
}

enum ReferralTreatmentStatus {
  REFERRED
  CONSULTATION_COMPLETED
  UNDER_TREATMENT
  ADMITTED
  DISCHARGED
  COMPLETED
}

enum MedicationAdherenceLevel {
  FULL
  PARTIAL
  NON_ADHERENT
}

model PatientFollowUp {
  id                      String                  @id @default(uuid())
  referralId              String
  patientId               String
  patientName             String
  patientAge              Int
  patientGender           String
  patientPhone            String?
  patientAbhaId           String?
  patientVillage          String
  patientAddress          String?
  ashaWorkerId            String
  ashaWorkerName          String
  ashaWorkerPhone         String?
  referringPhcId          String
  referringPhcName        String
  higherPhcId             String
  higherPhcName           String
  condition               String
  category                String                  @default("GENERAL")
  referralDate            DateTime                @default(now())
  referralReason          String
  referralTreatmentStatus ReferralTreatmentStatus @default(REFERRED)
  higherPhcDoctorId       String?
  higherPhcDoctorName     String?
  higherPhcDoctorNotes    String?
  higherPhcUpdatedAt      DateTime?
  scheduledDueDate        String
  followUpDate            String?
  nextVisitDate           String?
  status                  FollowUpStatus          @default(PENDING)
  isOverdue               Boolean                 @default(false)
  daysOverdue             Int                     @default(0)
  conditionUpdate         PatientConditionState?
  vitals                  String?                 // JSON encoded vitals
  medicinesTaken          String                  // JSON array
  adherenceRate           MedicationAdherenceLevel @default(FULL)
  notes                   String
  reminderSent            Boolean                 @default(false)
  reminderSentAt          DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  timelineEvents          FollowUpTimelineEvent[]

  @@map("patient_follow_ups")
}

model FollowUpTimelineEvent {
  id              String           @id @default(uuid())
  followUpId      String
  type            String
  title           String
  description     String
  performedBy     String
  role            String
  facilityName    String?
  timestamp       DateTime         @default(now())
  notes           String?
  metadata        String?          // JSON encoded metadata

  followUp        PatientFollowUp  @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@map("follow_up_timeline_events")
}


